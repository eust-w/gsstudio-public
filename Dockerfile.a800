# syntax=docker/dockerfile:1
# GPU application overlay. Supply an image you build and license yourself.
# This repository does not reproduce or distribute the HY-World CUDA runtime.
# Required base layout: /opt/hyworld2, /opt/panogen/bin/python,
# /opt/vllm/bin/python, CUDA/PyTorch extensions, supervisord, and model tools.
# See docs/deployment.md for the complete runtime prerequisites.
ARG HYWORLD_BASE_IMAGE
FROM ${HYWORLD_BASE_IMAGE}

USER root

ENV GSSTUDIO_DATA_DIR=/data/tasks \
    GSSTUDIO_HF_HOME=/models/hf-cache \
    HF_HOME=/models/hf-cache \
    TORCH_HOME=/models/torch-cache \
    GSSTUDIO_HYWORLD_REPO=/opt/hyworld2 \
    GSSTUDIO_NUM_GPUS=5 \
    GSSTUDIO_PORT=8000 \
    GSSTUDIO_MOCK_PIPELINE=false \
    GSSTUDIO_MANAGE_VLLM=true \
    VLLM_PORT=8100 \
    VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

RUN test -d /opt/hyworld2/hyworld2/worldgen \
    && test -x /opt/panogen/bin/python \
    && test -x /opt/vllm/bin/python \
    && command -v supervisord \
    && python -c "import sys; assert sys.version_info >= (3, 11); import fastapi, uvicorn, aiofiles, numpy; from PIL import Image"

# Keep generic package constraints separate from the user-provided model stack.
COPY deploy/requirements-security.txt /tmp/requirements-security.txt
RUN pip install --no-cache-dir --index-url https://pypi.org/simple --upgrade -r /tmp/requirements-security.txt \
    && rm /tmp/requirements-security.txt

# WorldNav depends on both the native SpatialIndex library and its Python
# binding.  Build-time and startup checks prevent the upstream silent fallback.
RUN apt-get update && apt-get install --yes --no-install-recommends \
        libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir rtree \
    && python -c "import rtree; print('rtree preflight OK')"

# Reapply the idempotent offline-loading patch as a release invariant rather
# than assuming it was present in the inherited image.
COPY deploy/scripts/patch_hyworld_local_cache.py /tmp/patch_hyworld_local_cache.py
RUN python /tmp/patch_hyworld_local_cache.py \
        /opt/hyworld2/hyworld2/worldgen/models/worldstereo_wrapper.py \
    && rm /tmp/patch_hyworld_local_cache.py

# Patch the upstream GS-data entrypoint in place so it consumes only the
# accepted WorldStereo trajectory ids generated by GSStudio's quality gate.
COPY deploy/scripts/patch_hyworld_quality_filter.py /tmp/patch_hyworld_quality_filter.py
RUN python /tmp/patch_hyworld_quality_filter.py \
        /opt/hyworld2/hyworld2/worldgen/gen_gs_data.py \
    && rm /tmp/patch_hyworld_quality_filter.py

# Limit full-FSDP WorldStereo to the diverse candidates validated by NavMesh.
COPY deploy/scripts/patch_hyworld_video_filter.py /tmp/patch_hyworld_video_filter.py
RUN python /tmp/patch_hyworld_video_filter.py \
        /opt/hyworld2/hyworld2/worldgen/video_gen.py \
    && rm /tmp/patch_hyworld_video_filter.py

# Render only the new conservative camera paths created during recovery;
# rerendering every original WorldNav path defeats the bounded GPU budget.
COPY deploy/scripts/patch_hyworld_render_filter.py /tmp/patch_hyworld_render_filter.py
RUN python /tmp/patch_hyworld_render_filter.py \
        /opt/hyworld2/hyworld2/worldgen/traj_render.py \
    && rm /tmp/patch_hyworld_render_filter.py

# Replace the public application surface and API/worker implementation.
COPY web/dist/ /app/web/dist/
COPY server/ /app/server/
COPY deploy/supervisord.conf /etc/supervisor/conf.d/gsstudio.conf
COPY deploy/scripts/entrypoint.sh /app/entrypoint.sh
COPY deploy/scripts/prefetch_models.sh /app/prefetch_models.sh
RUN chmod +x /app/entrypoint.sh

COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /app/
COPY third_party/licenses/ /app/third_party/licenses/

WORKDIR /app
EXPOSE 8000 8100
ENTRYPOINT ["/app/entrypoint.sh"]
